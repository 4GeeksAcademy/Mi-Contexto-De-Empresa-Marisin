                "trigger_order_id": { "type": "integer", "minimum": 1 }
              },
              "required": ["warehouse", "client_id", "product_id", "product_category", "quantity", "country", "min_threshold", "threshold_source", "trigger_order_id"],
              "additionalProperties": false
            }
          },
          "required": ["event_type", "properties"]
        }
      ],
      "description": "Stock crosses from below the threshold to at or above it after an inbound order.",
      "x-category": "Negocio/inventario",
      "x-origin": "opportunity",
      "x-delivery": "stream",
      "x-pii": { "present": true, "fields": ["sessionId", "userId", "requestId"], "treatment": "Opaque IDs only." },
      "x-level": "info",
      "x-value-property": "quantity"
    },
    "user_login_succeeded": {
      "allOf": [
        { "$ref": "#/definitions/envelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "user_login_succeeded" },
            "userId": { "type": "string", "minLength": 1 },
