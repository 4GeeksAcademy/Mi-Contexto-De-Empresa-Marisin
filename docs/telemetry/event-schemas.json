        }
      ],
      "description": "Successful backoffice authentication after the token is stored.",
      "x-category": "Autenticación",
      "x-origin": "opportunity",
      "x-delivery": "batch",
      "x-pii": { "present": true, "fields": ["sessionId", "userId", "requestId"], "treatment": "Opaque identifiers only; no credentials." },
      "x-level": "info",
      "x-value-property": null
    },
    "user_login_failed": {
      "allOf": [
        { "$ref": "#/definitions/envelope" },
        {
          "type": "object",
          "properties": {
