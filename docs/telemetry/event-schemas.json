              "required": ["warehouse", "client_id", "product_id", "product_category", "quantity", "country", "min_threshold", "threshold_source", "trigger_order_id"],
              "additionalProperties": false
            }
          },
          "required": ["event_type", "properties"]
        }
      ],
      "description": "Stock crosses from at or above the threshold to below it after an outbound order.",
