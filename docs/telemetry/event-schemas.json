            }
          },
          "required": ["event_type", "properties"]
        }
      ],
      "description": "Failed authentication; userId is null and no credential is captured.",
      "x-category": "Autenticación/seguridad",
      "x-origin": "opportunity",
      "x-delivery": "stream",
      "x-pii": { "present": true, "fields": ["sessionId", "requestId"], "treatment": "Opaque IDs only; userId null; email, password and hash excluded." },
      "x-level": "warn",
      "x-value-property": null
    },
    "session_expired": {
      "allOf": [
        { "$ref": "#/definitions/envelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "session_expired" },
            "userId": { "type": "string", "minLength": 1 },
            "properties": {
              "type": "object",
              "properties": {
                "route": { "$ref": "#/definitions/route_template" },
                "api_endpoint": { "$ref": "#/definitions/route_template" }
              },
              "required": ["route", "api_endpoint"],
              "additionalProperties": false
            }
          },
          "required": ["event_type", "properties"]
        }
      ],
      "description": "A protected API request receives HTTP 401 before the client clears the session.",
      "x-category": "Autenticación",
      "x-origin": "opportunity",
      "x-delivery": "batch",
      "x-pii": { "present": true, "fields": ["sessionId", "userId", "requestId"], "treatment": "Opaque IDs only; route and endpoint templates have no query values." },
      "x-level": "warn",
      "x-value-property": null
    },
    "user_logged_out": {
      "allOf": [
        { "$ref": "#/definitions/envelope" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "user_logged_out" },
            "userId": { "type": "string", "minLength": 1 },
            "properties": {
              "type": "object",
              "properties": {
                "session_duration_ms": { "type": "integer", "minimum": 0 }
              },
              "required": ["session_duration_ms"],
              "additionalProperties": false
            }
          },
          "required": ["event_type", "properties"]
        }
      ],
      "description": "Explicit logout before the client removes the token.",
      "x-category": "Autenticación",
      "x-origin": "opportunity",
      "x-delivery": "batch",
      "x-pii": { "present": true, "fields": ["sessionId", "userId", "requestId"], "treatment": "Opaque IDs only." },
      "x-level": "info",
      "x-value-property": "session_duration_ms"
    },
    "route_access_denied": {
      "allOf": [
