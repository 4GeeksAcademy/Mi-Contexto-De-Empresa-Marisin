    {
      "id": "a01",
      "kind": "grounding",
      "question": "¿Cuál es la ventana de devolución estándar?",
      "expected_path": [
        "receive_question",
        "route_question",
        "retrieve",
        "generate_answer",
        "compose_answer"
      ],
      "expected_status": "answered",
      "expected_sources": [
        "returns-policy"
      ],
      "answer_must_include": [
        "30 días"
      ],
      "expected_route": [
        "rag"
      ]
    },
    {
