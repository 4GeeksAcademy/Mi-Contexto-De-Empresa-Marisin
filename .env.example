JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESEND_API_KEY=
FRONTEND_URL=http://localhost:3000
AUTH_EMAIL_FROM=TrackFlow <onboarding@resend.dev>
AUTH_SECRET=replace-with-a-long-random-secret

# Telemetría: endpoint de ingesta (solo establece el patrón; el backoffice usa NEXT_PUBLIC_TELEMETRY_ENDPOINT)
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# Cola de tareas (Celery): broker y result backend. En Docker, redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Asistente comercial RAG (Hito 7). Acceso LLM de estudiante de 4Geeks (API compatible con OpenAI).
# Dos modelos, dos trabajos: EMBEDDING_MODEL (embeddings) y LLM_MODEL (generación) deben ser distintos.
# Clave: 4geeks.com → Mi perfil → Recursos → Claves API para LLM → Generar clave.
# IDs de modelo SIN el prefijo "litellm/" que muestra la web (comprobado con /models).
LLM_API_URL=https://llm.4geeks.ai
LLM_API_KEY=
LLM_MODEL=madrid-spain/opnerouter/openai/gpt-6-luna
EMBEDDING_MODEL=madrid-spain/openrouter/perplexity/pplx-embed-v1-0.6b
# Opcional: solo si los embeddings usan otra URL o clave distinta de LLM_API_*
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
# Qdrant local (docker compose up -d qdrant). En Docker, la API usa http://qdrant:6333.
QDRANT_URL=http://localhost:6333
# Solo para Qdrant Cloud
QDRANT_API_KEY=

# Servidor MCP de TrackFlow (mcps/trackflow_mcp) con OAuth vía MCP Auth + Logto.
# El agente LangGraph ya no llama a la API directamente: usa el servidor MCP como cliente.
MCP_AUTH_ISSUER=https://<tenant>.logto.app/oidc
# Identificador del recurso = API identifier en Logto = aud del token = URL pública del puerto 8001 de Codespaces
MCP_RESOURCE_URL=https://<codespace>-8001.app.github.dev/mcp
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_PORT=8001
TRACKFLOW_API_URL=http://localhost:8000
MCP_ALLOWED_ORIGINS=*
# Identidad de servicio del MCP ante la API (cabecera X-Service-Key, ≥ 32 caracteres).
# La misma clave en la API y en el MCP. Genérala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si falta o es corta, la vía de servicio queda desactivada y el MCP recibe 401.
TRACKFLOW_SERVICE_KEY=
# App M2M trackflow-mcp-admin (los 3 scopes): solo para MCP Playground y el smoke test
MCP_ADMIN_CLIENT_ID=
MCP_ADMIN_CLIENT_SECRET=
# App M2M trackflow-agent (incidents:read inventory:read): la usa el agente
MCP_AGENT_CLIENT_ID=
MCP_AGENT_CLIENT_SECRET=

# Admin inicial (opcional). Sin estas dos variables la API NO crea ningún admin por defecto.
# Contraseña de al menos 12 caracteres; úsala solo para el primer arranque y cámbiala después.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Prácticas seguras NIST · presupuesto de llamadas al LLM (POST /agent/query, chat WS y POST /knowledge/query).
# Por usuario autenticado y global (cortacircuitos de coste). Al superarlo: 429 con Retry-After.
LLM_RATE_LIMIT_PER_MINUTE=10
LLM_RATE_LIMIT_PER_DAY=200
LLM_GLOBAL_RATE_LIMIT_PER_MINUTE=60
# Acción irreversible (BRIEFING §5.2): salidas de inventario con estas unidades o más exigen confirmación humana (409 sin ella).
HIGH_VALUE_DISPATCH_UNITS=500
