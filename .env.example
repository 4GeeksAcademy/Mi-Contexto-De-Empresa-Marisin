JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESEND_API_KEY=
FRONTEND_URL=http://localhost:3000
AUTH_EMAIL_FROM=TrackFlow <onboarding@resend.dev>
AUTH_SECRET=replace-with-a-long-random-secret

# Telemetría: endpoint de ingesta (solo establece el patrón; el backoffice usa NEXT_PUBLIC_TELEMETRY_ENDPOINT)
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# Cola de tareas (Celery): broker y result backend. En Docker, redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Asistente comercial RAG (Hito 7). Acceso LLM de estudiante de 4Geeks (API compatible con OpenAI).
# Dos modelos, dos trabajos: EMBEDDING_MODEL (embeddings) y LLM_MODEL (generación) deben ser distintos.
# Clave: 4geeks.com → Mi perfil → Recursos → Claves API para LLM → Generar clave.
# IDs de modelo SIN el prefijo "litellm/" que muestra la web (comprobado con /models).
LLM_API_URL=https://llm.4geeks.ai
LLM_API_KEY=
LLM_MODEL=madrid-spain/opnerouter/openai/gpt-6-luna
EMBEDDING_MODEL=madrid-spain/openrouter/perplexity/pplx-embed-v1-0.6b
# Opcional: solo si los embeddings usan otra URL o clave distinta de LLM_API_*
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
# Qdrant local (docker compose up -d qdrant). En Docker, la API usa http://qdrant:6333.
QDRANT_URL=http://localhost:6333
# Solo para Qdrant Cloud
QDRANT_API_KEY=
